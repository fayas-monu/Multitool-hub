{
  "id": "./",
  "name": "MULTI TOOL HUB — Media Tools & PDF Tools",
  "short_name": "MULTI TOOL HUB",
  "description": "Twenty-three browser-native tools for PDF, image, media and After Hours work. Files stay on your device.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "browser"],
  "orientation": "any",
  "background_color": "#0f172a",
  "theme_color": "#0f172a",
  "categories": ["productivity", "utilities", "photo", "video"],
  "icons": [
    { "src": "assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "assets/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "assets/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "PDF Viewer & Editor",
      "short_name": "Viewer",
      "description": "Open the flagship PDF reading and annotation workspace.",
      "url": "./tools/viewer.html",
      "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Merge PDF",
      "short_name": "Merge",
      "description": "Combine PDFs in the order you choose.",
      "url": "./tools/merge.html",
      "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Image Compressor",
      "short_name": "Compress",
      "description": "Batch-compress images to a quality or target size.",
      "url": "./tools/image-compress.html",
      "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Focus Studio",
      "short_name": "Focus",
      "description": "Timer, checklist and deliberate break rituals.",
      "url": "./tools/focus-studio.html",
      "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "After Hours",
      "short_name": "After",
      "description": "Ambient soundscapes, breathing room, colour lab and focus rituals.",
      "url": "./entertainment.html",
      "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
