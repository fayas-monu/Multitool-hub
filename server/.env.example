# Copy this file to server/.env and fill in your own values.
# Never commit a real key. The browser never receives GEMINI_API_KEY.

# Required to enable the optional Gemini assistant.
GEMINI_API_KEY=

# A current Gemini model that supports generateContent.
GEMINI_MODEL=gemini-2.5-flash

# Local address and port. Keep HOST=127.0.0.1 unless you use a reverse proxy.
HOST=127.0.0.1
PORT=8787

# Optional shared secret. If set, the Connect Gemini dialog asks for it and
# every assistant request must send "Authorization: Bearer <token>".
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CLIENT_TOKEN=

# Comma-separated origins allowed to call /api/assistant from another domain.
# Leave empty when the site and API share an origin (the default server does).
# Example: https://tools.example.com,https://www.tools.example.com
ALLOWED_ORIGINS=

# Requests per IP inside the window. Defaults: 20 requests / 60 seconds.
RATE_LIMIT=20
RATE_WINDOW_SECONDS=60

# Set to 1 only behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=0
